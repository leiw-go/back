<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yaowenltd.projectinfomationmanage.mapper.llm.LlmProviderMapper">

    <resultMap id="LlmProviderResult" type="com.yaowenltd.projectinfomationmanage.model.entity.LlmProvider">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="baseUrl" column="base_url"/>
        <result property="apiKeyCiphertext" column="api_key_ciphertext"/>
        <result property="enabled" column="enabled"/>
        <result property="priority" column="priority"/>
        <result property="timeoutMsOverride" column="timeout_ms_override"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        id, name, base_url, api_key_ciphertext, enabled, priority,
        timeout_ms_override, created_at, updated_at
    </sql>

    <select id="findProviderById" resultMap="LlmProviderResult">
        SELECT <include refid="columns"/>
        FROM t_llm_provider
        WHERE id = #{id}
    </select>

    <select id="findProviderByName" resultMap="LlmProviderResult">
        SELECT <include refid="columns"/>
        FROM t_llm_provider
        WHERE name = #{name}
        LIMIT 1
    </select>

    <select id="findEnabledProviders" resultMap="LlmProviderResult">
        SELECT <include refid="columns"/>
        FROM t_llm_provider
        WHERE enabled = 1
        ORDER BY priority ASC, name ASC
    </select>

    <select id="findAllProviders" resultMap="LlmProviderResult">
        SELECT <include refid="columns"/>
        FROM t_llm_provider
        ORDER BY priority ASC, name ASC
    </select>

    <insert id="insertProvider" parameterType="com.yaowenltd.projectinfomationmanage.model.entity.LlmProvider">
        INSERT INTO t_llm_provider
            (id, name, base_url, api_key_ciphertext, enabled, priority, timeout_ms_override)
        VALUES
            (#{id}, #{name}, #{baseUrl}, #{apiKeyCiphertext},
             #{enabled}, #{priority}, #{timeoutMsOverride})
    </insert>

    <update id="updateProvider" parameterType="com.yaowenltd.projectinfomationmanage.model.entity.LlmProvider">
        UPDATE t_llm_provider
        SET name = #{name},
            base_url = #{baseUrl},
            enabled = #{enabled},
            priority = #{priority},
            timeout_ms_override = #{timeoutMsOverride}
        WHERE id = #{id}
    </update>

    <update id="updateApiKey">
        UPDATE t_llm_provider
        SET api_key_ciphertext = #{ciphertext}
        WHERE id = #{id}
    </update>

    <delete id="deleteProviderById">
        DELETE FROM t_llm_provider WHERE id = #{id}
    </delete>

</mapper>