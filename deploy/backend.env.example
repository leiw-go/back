# ============================================================
# 生产环境容器环境变量模板
#
#   cp deploy/backend.env.example deploy/backend.env   然后按实际填写
#
# deploy/backend.env 含真实凭据，已在 .gitignore 中排除，**不要提交到仓库**。
# 部署脚本会把它上传到远程机的部署目录下。
# ============================================================

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- 数据库：远程机上的独立 MySQL 实例 ----
# 后端与 MySQL 在同一个 docker 网络（deploy-net）时，用容器名 mysql 即可解析。
# 不同网络时改成 MySQL 的内网 IP / 域名。
DB_URL=jdbc:mysql://mysql:3306/project_info_manage?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf-8
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ---- JWT ----
# 必须改成真实值。生成方式：openssl rand -base64 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=86400000

# ---- JVM ----
# 机器内存较小时限制堆。JAVA_TOOL_OPTIONS 由 JVM 自动识别，无需改镜像。
JAVA_TOOL_OPTIONS=-Xmx320m -Xms128m -XX:MaxMetaspaceSize=128m

# ---- 飞书机器人 ----
# 不接飞书就保持 enabled=false
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_ENABLED=false
FEISHU_WEBHOOK_TIMEOUT_MS=3000
FEISHU_WEBHOOK_SECRET=

# ---- Flyway ----
# 全新的空库不需要 baseline，保持 false 即可；
# 若要接管一个"已有表但没有 flyway 历史"的存量库，首次部署置 true。
FLYWAY_BASELINE_ON_MIGRATE=false
